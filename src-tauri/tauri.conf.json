{
    "productName":  "Daily Planner",
    "version":  "1.0.5",
    "identifier":  "com.dailyplanner.app",
    "build":  {
                  "beforeDevCommand":  "npm run dev:client",
                  "devUrl":  "http://localhost:5173",
                  "beforeBuildCommand":  "npm run build",
                  "frontendDist":  "../dist"
              },
    "app":  {
                "withGlobalTauri":  true,
                "windows":  [
                                {
                                    "title":  "Daily Planner",
                                    "width":  1200,
                                    "height":  800,
                                    "minWidth":  900,
                                    "minHeight":  600,
                                    "resizable":  true,
                                    "fullscreen":  false,
                                    "decorations":  true,
                                    "visible":  false
                                }
                            ],
                "security":  {
                                 "csp":  null
                             },
                "trayIcon":  {
                                 "iconPath":  "icons/icon.ico",
                                 "iconAsTemplate":  false
                             }
            },
    "bundle":  {
                   "active":  true,
                   "targets":  [
                                   "nsis"
                               ],
                   "icon":  [
                                "icons/32x32.png",
                                "icons/128x128.png",
                                "icons/128x128@2x.png",
                                "icons/icon.ico",
                                "icons/Square30x30Logo.png",
                                "icons/Square44x44Logo.png",
                                "icons/Square71x71Logo.png",
                                "icons/Square89x89Logo.png",
                                "icons/Square107x107Logo.png",
                                "icons/Square142x142Logo.png",
                                "icons/Square150x150Logo.png",
                                "icons/Square284x284Logo.png",
                                "icons/Square310x310Logo.png",
                                "icons/StoreLogo.png"
                            ],
                   "resources":  [
                                     "../dist/**/*",
                                     "../server/**/*",
                                     "../knexfile.js",
                                     "../node_modules/**/*",
                                     "../.env"
                                 ],
                   "copyright":  "Copyright (C) 2026 Daily Planner. All rights reserved.",
                   "shortDescription":  "Offline daily planner desktop application",
                   "windows":  {
                                   "certificateThumbprint":  null,
                                   "digestAlgorithm":  "sha256",
                                   "timestampUrl":  "",
                                   "webviewInstallMode":  {
                                                              "type":  "downloadBootstrapper",
                                                              "silent":  true
                                                          },
                                   "nsis":  {
                                                "installerIcon":  "icons/icon.ico",
                                                "uninstallerIcon":  "icons/icon.ico",
                                                "headerImage":  null,
                                                "sidebarImage":  null,
                                                "languages":  [
                                                                  "SimpChinese"
                                                              ],
                                                "displayLanguageSelector":  false
                                            }
                               }
               }
}